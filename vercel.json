{
  "version": 2,
  "framework": null,
  "installCommand": "echo 'skip npm'",
  "buildCommand": "echo 'vercel-php handles composer'",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "/build/(.*)",  "dest": "/build/$1"  },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/css/(.*)",    "dest": "/css/$1"    },
    { "src": "/js/(.*)",     "dest": "/js/$1"     },
    { "src": "/(.*)",        "dest": "/api/index.php" }
  ],
  "env": {
    "APP_NAME":         "Lens Eyewear",
    "APP_ENV":          "production",
    "APP_DEBUG":        "true",
    "APP_KEY":          "base64:9vTNV/5yWkHTpcnRCxw781NcXHMdEuTb5dWmWEHIuGA=",
    "APP_URL":          "https://lens-rho-sable.vercel.app",
    "LOG_CHANNEL":      "stderr",
    "LOG_LEVEL":        "debug",
    "DB_CONNECTION":    "sqlite",
    "DB_DATABASE":      "/tmp/database.sqlite",
    "CACHE_STORE":      "file",
    "CACHE_DRIVER":     "file",
    "SESSION_DRIVER":   "cookie",
    "QUEUE_CONNECTION": "sync"
  }
}
